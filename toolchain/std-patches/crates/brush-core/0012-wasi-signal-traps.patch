+/// The process disposition a trap sets for its signal.
+#[derive(Clone, Copy)]
+pub enum TrapDisposition {
+    /// `trap - SIG`: take the default action.
+    Default,
+    /// `trap '' SIG`: ignore the signal.
+    Ignore,
+    /// `trap 'command' SIG`: catch the signal and run the command between commands.
+    Catch,
+}
+
+/// Bit `n` is set when signal `n` was caught and its trap has not run yet.
+static PENDING_TRAP_SIGNALS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+extern "C" fn record_pending_trap_signal(signal: i32) {
+    if (1..64).contains(&signal) {
+        PENDING_TRAP_SIGNALS.fetch_or(1 << signal, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+#[cfg(target_os = "wasi")]
+unsafe extern "C" {
+    // The agentOS wasi-libc `signal()`: stores the handler for the signal trampoline and
+    // reports the disposition to the kernel.
+    #[link_name = "signal"]
+    fn libc_signal(signal: i32, handler: usize) -> usize;
+    // wasi-libc's SIG_IGN and SIG_ERR are these functions' addresses, not 1 and -1: table
+    // index 1 is a valid function pointer on wasm.
+    fn __SIG_IGN(signal: i32);
+    fn __SIG_ERR(signal: i32);
+}
+
+/// Sets the process disposition for a trapped signal, as bash does with `sigaction`.
+#[cfg(target_os = "wasi")]
+pub fn set_trap_disposition(
+    signal: Signal,
+    disposition: TrapDisposition,
+) -> Result<(), error::Error> {
+    const SIG_DFL: usize = 0;
+    let sig_ign = __SIG_IGN as usize;
+    let sig_err = __SIG_ERR as usize;
+    // Linux rejects a disposition change for SIGKILL and SIGSTOP; bash ignores the trap.
+    if matches!(signal, Signal::Sigkill | Signal::Sigstop) {
+        return Ok(());
+    }
+    let handler = match disposition {
+        TrapDisposition::Default => SIG_DFL,
+        TrapDisposition::Ignore => sig_ign,
+        TrapDisposition::Catch => record_pending_trap_signal as usize,
+    };
+    // SAFETY: the handler only performs an atomic store, which is safe in a signal handler.
+    if unsafe { libc_signal(signal as i32, handler) } == sig_err {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    Ok(())
+}
+
+/// Returns the lowest-numbered caught signal whose trap has not run yet, without taking it.
+pub fn pending_trap_signal() -> Option<Signal> {
+    let pending = PENDING_TRAP_SIGNALS.load(std::sync::atomic::Ordering::SeqCst);
+    (1..64)
+        .filter(|signal| pending & (1 << signal) != 0)
+        .find_map(|signal| Signal::try_from(signal).ok())
+}
+
+/// Returns the signals caught since the last call, lowest number first.
+pub(crate) fn take_pending_trap_signals() -> Vec<Signal> {
+    let pending = PENDING_TRAP_SIGNALS.swap(0, std::sync::atomic::Ordering::SeqCst);
+    (1..64)
+        .filter(|signal| pending & (1 << signal) != 0)
+        .filter_map(|signal| Signal::try_from(signal).ok())
+        .collect()
+}
