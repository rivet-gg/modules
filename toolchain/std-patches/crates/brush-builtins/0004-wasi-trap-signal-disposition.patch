+/// Applies a trap to the process signal disposition, as bash does: `trap '' SIG` ignores SIG,
+/// `trap 'command' SIG` catches it, and removing the trap (`None`) restores the default.
+/// Subshells run in this process as clones of the shell, so only the top-level shell may change
+/// the disposition; a subshell's trap must not leak into its parent.
+#[cfg(target_os = "wasi")]
+fn set_trap_disposition(signal: TrapSignal, handler: Option<&str>) -> Result<(), brush_core::Error> {
+    use brush_core::sys::signal::TrapDisposition;
+    let TrapSignal::Signal(signal) = signal else {
+        return Ok(());
+    };
+    let disposition = match handler {
+        None => TrapDisposition::Default,
+        Some("") => TrapDisposition::Ignore,
+        Some(_) => TrapDisposition::Catch,
+    };
+    brush_core::sys::signal::set_trap_disposition(signal, disposition)
+}
+
+#[cfg(not(target_os = "wasi"))]
+fn set_trap_disposition(_signal: TrapSignal, _handler: Option<&str>) -> Result<(), brush_core::Error> {
+    Ok(())
+}
